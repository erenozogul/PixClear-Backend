{
  "name": "pixclear-backend",
  "private": true,
  "version": "0.1.0",
  "description": "PixClear API: galeri fotoğraflarını analiz eder, benzerleri gruplar, en iyisini seçer ve fotoğrafları optimize eder.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=esm --packages=external",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.0",
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  }
}
